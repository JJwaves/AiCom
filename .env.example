# ---------- Commerce ----------
# When both are set, the storefront switches from the seed catalog to Shopify.
# The Storefront token is public-safe by design. NEVER put the Admin API token
# in any NEXT_PUBLIC_ variable or in this file's real counterpart committed to git.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Server-only Shopify secrets (webhooks, Admin API — used by future server jobs)
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# ---------- Pricing safety ----------
# Seed pricing renders with a visible "demo pricing" notice until this is
# explicitly set to false AND real prices are loaded.
NEXT_PUBLIC_DEMO_PRICING=true

# ---------- Google ----------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# ---------- Meta ----------
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only — Conversions API. Never referenced in client code.
META_ACCESS_TOKEN=
META_DATASET_ID=

# ---------- Database ----------
# Production/staging: a standard Postgres connection string. Migrations are
# applied explicitly there: `npm run db:migrate`.
# Unset (development/tests): an embedded PGlite Postgres self-migrates at
# PGLITE_DATA_DIR (default .data/pglite; tests use memory://). No setup needed.
DATABASE_URL=
PGLITE_DATA_DIR=

# ---------- First-party events ----------
# The storefront dual-writes selected analytics events to /api/events (our own
# database) in addition to the consent-gated GA4/Meta dataLayer. Set to false
# to disable first-party event persistence entirely.
NEXT_PUBLIC_FIRST_PARTY_EVENTS=true

# ---------- Quote intake ----------
# JSON POST target for custom-quote requests (helpdesk / Zapier / email service).
# Unset = requests log to the server console (development).
QUOTE_WEBHOOK_URL=

# ---------- AI runtime (Session 04 — all OFF by default) ----------
# Master switch for lib/ai. Everything below is inert until this is "true".
# Commerce works fully with every AI flag off.
AI_RUNTIME_ENABLED=false
# Customer-facing "AI Packaging Expert" chat (Session 05): requires
# AI_RUNTIME_ENABLED=true + a provider key. Off = no chat UI, /api/ai/chat
# answers 503, storefront unaffected. Before enabling for customers, verify
# the configured model ids with `npm run ai:smoke` (credential-gated,
# never part of tests/build).
AI_SALES_ENABLED=false
# Customer Intelligence (Session 08): gates /admin/customer-intelligence and
# its processing endpoint. Deterministic metrics render with just this flag;
# AI classification of conversations additionally needs AI_RUNTIME_ENABLED
# + a provider key. Off = the admin surface 404s, commerce unaffected.
AI_CUSTOMER_INTELLIGENCE_ENABLED=false

# Provider selection (configuration, not code). Implemented: anthropic.
# Interface-ready, not yet implemented: openai, gemini.
AI_PROVIDER=anthropic
# Server-only keys — NEVER NEXT_PUBLIC_*, never committed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Model routing by workload class (LOW_COST: classification/extraction,
# STANDARD: customer-facing conversation, REASONING: business analysis).
# Defaults (in lib/ai/config.ts): haiku-4-5 / sonnet-5 / opus-5.
AI_MODEL_LOW_COST=
AI_MODEL_STANDARD=
AI_MODEL_REASONING=

# AI spend caps (USD, UTC windows). Unset = no cap (documented default).
# NOTE: budgets require pricing for the active models in config/ai-pricing.ts
# — budgets over unmeasurable spend fail closed.
AI_DAILY_BUDGET_USD=
AI_MONTHLY_BUDGET_USD=

# Tuning (defaults in lib/ai/config.ts; normally leave unset):
# AI_REQUEST_TIMEOUT_MS=30000       provider call timeout
# AI_PROVIDER_MAX_RETRIES=1         transport retries on 429/5xx
# AI_MAX_OUTPUT_TOKENS=16000        per-call output cap (incl. thinking)
# AI_MAX_TOOL_CALLS_PER_TURN=8      tool-loop safety limits
# AI_MAX_MODEL_CALLS_PER_TURN=5
# AI_MAX_TURN_DURATION_MS=120000
# AI_STRUCTURED_RETRY_LIMIT=1

# ---------- Admin (Session 08 — first admin surface) ----------
# HTTP Basic credentials for /admin and /api/admin (proxy.ts + per-route
# checks). FAIL CLOSED: while unset, every admin path answers 404 — the
# surface does not exist. Set BOTH to enable. Use a long random password;
# rotate by changing the values (no session state to invalidate).
ADMIN_USER=
ADMIN_PASSWORD=
