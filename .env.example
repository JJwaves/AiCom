# ---------- Commerce ----------
# When both are set, the storefront switches from the seed catalog to Shopify.
# The Storefront token is public-safe by design. NEVER put the Admin API token
# in any NEXT_PUBLIC_ variable or in this file's real counterpart committed to git.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Server-only Shopify secrets (webhooks, Admin API — used by future server jobs)
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# ---------- Pricing safety ----------
# Seed pricing renders with a visible "demo pricing" notice until this is
# explicitly set to false AND real prices are loaded.
NEXT_PUBLIC_DEMO_PRICING=true

# ---------- Google ----------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# ---------- Meta ----------
NEXT_PUBLIC_META_PIXEL_ID=
# Server-only — Conversions API. Never referenced in client code.
META_ACCESS_TOKEN=
META_DATASET_ID=

# ---------- Database ----------
# Production/staging: a standard Postgres connection string. Migrations are
# applied explicitly there: `npm run db:migrate`.
# Unset (development/tests): an embedded PGlite Postgres self-migrates at
# PGLITE_DATA_DIR (default .data/pglite; tests use memory://). No setup needed.
DATABASE_URL=
PGLITE_DATA_DIR=

# ---------- First-party events ----------
# The storefront dual-writes selected analytics events to /api/events (our own
# database) in addition to the consent-gated GA4/Meta dataLayer. Set to false
# to disable first-party event persistence entirely.
NEXT_PUBLIC_FIRST_PARTY_EVENTS=true

# ---------- Quote intake ----------
# JSON POST target for custom-quote requests (helpdesk / Zapier / email service).
# Unset = requests log to the server console (development).
QUOTE_WEBHOOK_URL=
